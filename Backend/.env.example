# CollegeWeb AI - Environment Configuration
# Copy this file to .env and configure your settings

# ── Web Crawling ─────────────────────────────────────────────────────────
# Get your key at https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ── LLM Tier 1: Google Gemini Flash (Primary) ────────────────────────────
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── LLM Tier 2: Hugging Face (Secondary) ──────────────────────────────────
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# ── LLM Tier 3: Ollama local (Fallback) ───────────────────────────────────
# No key required. Make sure Ollama is running locally with 'ollama run qwen2.5:1.5b'
OLLAMA_URL=http://localhost:11434
